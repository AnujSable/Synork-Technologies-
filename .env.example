# Firebase Configuration (Development)
# Copy this file to .env.local and fill in your actual values

# Firebase Web App Config
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# EmailJS Configuration
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_CONTACT_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_CONFIRMATION_TEMPLATE_ID=template_xxxxxxx

# Admin Email (for contact form recipient)
VITE_ADMIN_EMAIL=synorktechnologies@gmail.com

# Application Settings
VITE_APP_NAME=Synork
VITE_APP_URL=http://localhost:5173
